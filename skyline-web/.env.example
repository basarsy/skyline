# Base of every API call. Default: the relative /api/v1 (same origin; the Vite dev server and nginx proxy it).
# An absolute URL such as http://localhost:8000/api/v1 also works and relies on the gateway's CORS settings.
VITE_API_BASE=/api/v1

# Where the Vite dev server forwards /api (dev only; never shipped to the browser).
SKYLINE_GATEWAY_URL=http://localhost:8000
