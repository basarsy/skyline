# Copy to .env and fill in. .env is git-ignored.
# Load into your shell before starting services, e.g.:  set -a; source .env; set +a

# Shared by ALL services (must be identical everywhere). Generate with: openssl rand -base64 48
JWT_SECRET=
SKYLINE_INTERNAL_API_KEY=

# skyline-auth: initial ADMIN account (optional; created on startup if missing)
SKYLINE_ADMIN_EMAIL=
SKYLINE_ADMIN_PASSWORD=
