# Skyline environment variables
# Copy this file to .env and fill in your values. .env is git-ignored.
#   - docker compose reads .env automatically and refuses to start if a required value is missing.
#   - For running services from your shell instead:  set -a; source .env; set +a

# Required by ALL backend services (must be identical everywhere, min 32 bytes).
# Generate with: openssl rand -base64 48
JWT_SECRET=
SKYLINE_INTERNAL_API_KEY=

# skyline-auth: initial ADMIN account (optional; created on startup if missing, password min 12 chars)
SKYLINE_ADMIN_EMAIL=
SKYLINE_ADMIN_PASSWORD=
