# Skyline environment variables
# Copy this file to .env and fill in your values. .env is git-ignored.
#   - docker compose reads .env automatically and refuses to start if a required value is missing.
#   - For running services from your shell instead:  set -a; source .env; set +a
# Generate each secret with: openssl rand -hex 32

# Required by ALL backend services (must be identical everywhere, min 32 bytes).
JWT_SECRET=
SKYLINE_INTERNAL_API_KEY=

# Required: password of the PostgreSQL databases (compose creates them with it; services connect with it
# as DATABASE_PASSWORD) and of Redis (requirepass; used by fleet, route, crew and the gateway).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# skyline-auth: initial ADMIN account (optional; created on startup if missing, password min 12 chars)
SKYLINE_ADMIN_EMAIL=
SKYLINE_ADMIN_PASSWORD=

# skyline-gateway: browser origins allowed to call the API (CORS), comma-separated.
SKYLINE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# skyline-gateway: per-client-IP rate limit on login/register/refresh and PNR lookup (tokens per second,
# plus burst capacity). Raise both when running the e2e suites, which log in many times in quick succession.
SKYLINE_RATE_LIMIT_REPLENISH=5
SKYLINE_RATE_LIMIT_BURST=10

# skyline-schedule and skyline-reservation: ISO 4217 currency of every price (same value in both).
SKYLINE_CURRENCY=EUR
